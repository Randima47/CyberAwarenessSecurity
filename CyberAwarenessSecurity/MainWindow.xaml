<Window x:Class="CyberAwarenessSecurity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSecurity AwarenessBot"
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banner / Logo -->
        <TextBlock Text="CyberSecurity AwarenessBot"
                   Foreground="Red"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Subtitle -->
        <TextBlock Grid.Row="1"
                   Text="Outsmarting hackers so you don't have to"
                   Foreground="Cyan"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,15"
                   FontStyle="Italic"/>

        <!-- Chat Display -->
        <Border Grid.Row="2" BorderBrush="Cyan" BorderThickness="2" CornerRadius="8" Padding="5">
            <RichTextBox Name="ChatDisplay"
                         Foreground="White"
                         Background="#1A1A1A"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="14"/>
        </Border>

        <!-- Input + Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <TextBox Name="UserInput"
                     Width="500"
                     Height="30"
                     FontSize="14"
                     Background="#262626"
                     Foreground="White"
                     BorderBrush="Cyan"
                     BorderThickness="1"
                     Margin="0,0,10,0"
                     Text=""/>

            <Button Content="Ask"
                    Width="80"
                    Height="30"
                    Background="Cyan"
                    Foreground="Black"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Click="AskButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Cyan"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Yellow"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="Clear"
                    Width="80"
                    Height="30"
                    Background="Red"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="ClearButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

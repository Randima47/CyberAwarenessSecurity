<Window x:Class="CyberAwarenessSecurity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSecurity AwarenessBot"
        Height="800" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <!-- Global Styles -->
    <Window.Resources>
        <!-- Base Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#00FFFF"/>
            <!-- Cyan default -->
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Special Button Styles -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF3B3B"/>
            <!-- Red -->
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#32CD32"/>
            <!-- Green -->
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFA500"/>
            <!-- Orange -->
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Subtitle -->
            <RowDefinition Height="*"/>
            <!-- Tabs -->
        </Grid.RowDefinitions>

        <!-- Banner -->
        <TextBlock Text="CyberSecurity AwarenessBot"
                   Foreground="Red"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Subtitle -->
        <TextBlock Grid.Row="1"
                   Text="Outsmarting hackers so you don't have to"
                   Foreground="Cyan"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,15"
                   FontStyle="Italic"/>

        <!-- TabControl -->
        <TabControl Grid.Row="2" Background="#1A1A1A" Foreground="White" BorderBrush="Cyan" BorderThickness="1">

            <!-- Chat Tab -->
            <TabItem>
                <TabItem.Header>
                    <Border Background="#00BFFF" Padding="10,5">
                        <TextBlock Text="Chat"
                                   Foreground="White"
                                   FontWeight="Bold"/>
                    </Border>
                </TabItem.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat Display -->
                    <Border BorderBrush="Cyan" BorderThickness="2" CornerRadius="8" Padding="5" Margin="0,0,0,10">
                        <RichTextBox Name="ChatDisplay"
                                     Foreground="White"
                                     Background="#1A1A1A"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="14"/>
                    </Border>

                    <!-- Input + Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBox Name="UserInput" Width="400" Height="35" FontSize="14"
                                 Background="#262626" Foreground="White" BorderBrush="Cyan" Margin="0,0,10,0"/>
                        <Button Content="Ask" Width="90" Height="35" Click="AskButton_Click"/>
                        <Button Content="Fun Fact" Width="100" Height="35" Style="{StaticResource AccentButton}" Click="FunFactButton_Click"/>
                        <Button Content="Glossary" Width="100" Height="35" Background="Purple" Foreground="White" Click="GlossaryButton_Click"/>
                        <Button Content="Clear" Width="90" Height="35" Style="{StaticResource DangerButton}" Click="ClearButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tasks Tab -->
            <TabItem>
                <TabItem.Header>
                    <Border Background="#32CD32" Padding="10,5">
                        <TextBlock Text="Tasks"
                                   Foreground="White"
                                   FontWeight="Bold"/>
                    </Border>
                </TabItem.Header>
                <StackPanel Orientation="Vertical" Margin="10">
                    <ListView Name="TaskList" Height="200" Background="#1A1A1A" Foreground="White"
                              BorderBrush="Cyan" BorderThickness="1" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBox Name="TaskTitle" Width="150" Height="30" Margin="0,0,10,0"
                                 Background="#262626" Foreground="White" BorderBrush="Cyan"
                                 ToolTip="Enter task title"/>
                        <TextBox Name="TaskDescription" Width="250" Height="30" Margin="0,0,10,0"
                                 Background="#262626" Foreground="White" BorderBrush="Cyan"
                                 ToolTip="Enter task description"/>
                        <DatePicker Name="TaskReminder" Width="150" Height="30" Margin="0,0,10,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Add Task" Width="110" Height="35" Style="{StaticResource SuccessButton}" Click="AddTask_Click"/>
                        <Button Content="Complete Task" Width="130" Height="35" Style="{StaticResource AccentButton}" Click="CompleteTask_Click"/>
                        <Button Content="Delete Task" Width="110" Height="35" Style="{StaticResource DangerButton}" Click="DeleteTask_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Quiz Tab -->
            <TabItem>
                <TabItem.Header>
                    <Border Background="#FFA500" Padding="10,5">
                        <TextBlock Text="Quiz"
                                   Foreground="White"
                                   FontWeight="Bold"/>
                    </Border>
                </TabItem.Header>
                <StackPanel Orientation="Vertical" Margin="10">
                    <TextBlock Name="QuizQuestionText"
                               Text="Press 'Start Quiz' to begin."
                               Foreground="White"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>
                    <StackPanel Name="QuizOptionsPanel" Orientation="Vertical" Margin="0,0,0,15"/>
                    <TextBlock Name="QuizFeedback"
                               Foreground="Orange"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Start Quiz" Width="110" Height="35" Style="{StaticResource SuccessButton}" Click="StartQuiz_Click"/>
                        <Button Content="Next Question" Width="130" Height="35" Click="NextQuestion_Click"/>
                        <Button Content="Reset Quiz" Width="110" Height="35" Style="{StaticResource DangerButton}" Click="ResetQuiz_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Activity Log Tab -->
            <TabItem>
                <TabItem.Header>
                    <Border Background="#9370DB" Padding="10,5">
                        <TextBlock Text="Activity Log"
                                   Foreground="White"
                                   FontWeight="Bold"/>
                    </Border>
                </TabItem.Header>
                <StackPanel Orientation="Vertical" Margin="10">
                    <ListView Name="ActivityList" Height="200" Background="#1A1A1A" Foreground="White"
                              BorderBrush="Cyan" BorderThickness="1" Margin="0,0,0,15"/>
                    <Button Content="Clear Log" Width="110" Height="35" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Center" Click="ClearLog_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

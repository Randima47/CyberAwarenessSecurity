<Window x:Class="CyberAwarenessSecurity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSecurity AwarenessBot"
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banner / Logo -->
        <TextBlock Text="CyberSecurity AwarenessBot"
                   Foreground="Red"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Subtitle -->
        <TextBlock Grid.Row="1"
                   Text="Outsmarting hackers so you don't have to"
                   Foreground="Cyan"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,15"
                   FontStyle="Italic"/>

        <!-- Chat Display -->
        <Border Grid.Row="2" BorderBrush="Cyan" BorderThickness="2" CornerRadius="8" Padding="5">
            <RichTextBox Name="ChatDisplay"
                         Foreground="White"
                         Background="#1A1A1A"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="14"/>
        </Border>

        <!-- Input + Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <TextBox Name="UserInput"
                     Width="400"
                     Height="30"
                     FontSize="14"
                     Background="#262626"
                     Foreground="White"
                     BorderBrush="Cyan"
                     BorderThickness="1"
                     Margin="0,0,10,0"/>

            <!-- Ask Button -->
            <Button Content="Ask"
                    Width="80"
                    Height="30"
                    Background="Cyan"
                    Foreground="Black"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Click="AskButton_Click"/>

            <!-- Fun Fact Button -->
            <Button Content="Fun Fact"
                    Width="90"
                    Height="30"
                    Background="Orange"
                    Foreground="Black"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Click="FunFactButton_Click"/>

            <!-- Glossary Button -->
            <Button Content="Glossary"
                    Width="90"
                    Height="30"
                    Background="Purple"
                    Foreground="White"
                    FontWeight="Bold"
                    Margin="0,0,10,0"
                    Click="GlossaryButton_Click"/>

            <!-- Clear Chat Button -->
            <Button Content="Clear"
                    Width="80"
                    Height="30"
                    Background="Red"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="ClearButton_Click"/>
        </StackPanel>

        <!-- Task Assistant Panel -->
        <GroupBox Grid.Row="4" Header="Cybersecurity Tasks"
                  Foreground="Cyan" FontWeight="Bold" Margin="0,15,0,0"
                  BorderBrush="Cyan" BorderThickness="2">
            <StackPanel Orientation="Vertical" Margin="10">

                <!-- Task List -->
                <ListView Name="TaskList" Height="150" Background="#1A1A1A" Foreground="White"
                          BorderBrush="Cyan" BorderThickness="1" Margin="0,0,0,10">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" Width="40" DisplayMemberBinding="{Binding Id}" />
                            <GridViewColumn Header="Title" Width="150" DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="Description" Width="250" DisplayMemberBinding="{Binding Description}" />
                            <GridViewColumn Header="Reminder" Width="120" DisplayMemberBinding="{Binding ReminderDate}" />
                            <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Task Input Controls -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Name="TaskTitle" Width="150" Height="25" Margin="0,0,10,0"
                             Background="#262626" Foreground="White" BorderBrush="Cyan"
                             ToolTip="Enter task title"/>
                    <TextBox Name="TaskDescription" Width="250" Height="25" Margin="0,0,10,0"
                             Background="#262626" Foreground="White" BorderBrush="Cyan"
                             ToolTip="Enter task description"/>
                    <DatePicker Name="TaskReminder" Width="150" Height="25" Margin="0,0,10,0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Add Task" Width="100" Height="30" Margin="0,0,10,0"
                            Background="Green" Foreground="White" FontWeight="Bold"
                            Click="AddTask_Click"/>
                    <Button Content="Complete Task" Width="120" Height="30" Margin="0,0,10,0"
                            Background="Orange" Foreground="Black" FontWeight="Bold"
                            Click="CompleteTask_Click"/>
                    <Button Content="Delete Task" Width="100" Height="30"
                            Background="Red" Foreground="White" FontWeight="Bold"
                            Click="DeleteTask_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
